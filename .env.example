# Copy to .env.local and fill in your MySQL credentials.
# The database is created by `npm run db:setup` if it does not exist.
# Characters like @ : / # in the password must be URL-encoded (e.g. @ becomes %40).
DATABASE_URL="mysql://3uNXjVwUpXAs5x2.root:qTYit96OFAC0ziW6@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/prephub"

# TLS is used automatically for any host other than this machine (hosted MySQL needs it).
# DATABASE_SSL="false"            # turn TLS off for a remote server without it
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n..."   # only if your provider gives you a CA certificate

# Connections per server instance (default 3 in production, 10 in development).
# DATABASE_POOL_SIZE="3"

# Used to work out which plan day is "today".
APP_TIMEZONE="Asia/Kolkata"
